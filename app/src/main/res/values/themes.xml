<resources>
<style name="Theme.AnaAuto" parent="Theme.AppCompat.Light.NoActionBar">
<item name="colorPrimary">@color/brand</item><item name="colorPrimaryDark">@color/bg</item><item name="colorAccent">@color/brand</item>
<item name="android:windowBackground">@color/bg</item><item name="android:statusBarColor">@color/bg</item><item name="android:navigationBarColor">@color/card</item>
<item name="android:windowLightStatusBar">true</item><item name="android:windowLightNavigationBar">true</item>
<item name="android:textColorPrimary">@color/text</item><item name="android:textColorSecondary">@color/muted</item><item name="android:fontFamily">sans-serif</item>
</style>
<style name="FlowButton" parent="Widget.AppCompat.Button">
<item name="android:textAllCaps">false</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">14sp</item>
<item name="android:minHeight">48dp</item><item name="android:minWidth">0dp</item><item name="android:paddingLeft">14dp</item><item name="android:paddingRight">14dp</item><item name="android:stateListAnimator">@null</item><item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item>
</style>
<style name="FlowPrimary" parent="FlowButton"><item name="android:background">@drawable/bg_primary</item><item name="android:textColor">#FFFFFF</item></style>
<style name="FlowSecondary" parent="FlowButton"><item name="android:background">@drawable/bg_secondary</item><item name="android:textColor">@color/brand</item></style>
<style name="FlowInput" parent="Widget.AppCompat.EditText"><item name="android:textSize">14sp</item><item name="android:textColor">@color/text</item><item name="android:textColorHint">@color/muted</item><item name="android:padding">12dp</item><item name="android:background">@drawable/bg_input</item><item name="backgroundTint">@null</item><item name="android:singleLine">true</item></style>
</resources>