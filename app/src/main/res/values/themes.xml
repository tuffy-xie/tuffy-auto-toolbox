<resources>
<style name="Theme.AnaAuto" parent="Theme.AppCompat.DayNight.NoActionBar">
<item name="colorPrimary">@color/brand</item><item name="colorPrimaryDark">@color/bg</item><item name="colorAccent">@color/brand</item>
<item name="colorControlActivated">@color/brand</item><item name="colorControlNormal">@color/muted</item>
<item name="android:windowBackground">@color/bg</item><item name="android:statusBarColor">@color/bg</item><item name="android:navigationBarColor">@color/card</item>
<item name="android:windowLightStatusBar">@bool/light_bars</item><item name="android:windowLightNavigationBar">@bool/light_bars</item>
<item name="android:textColorPrimary">@color/text</item><item name="android:textColorSecondary">@color/muted</item><item name="android:fontFamily">sans-serif</item>
<item name="switchStyle">@style/IosSwitch</item>
<item name="alertDialogTheme">@style/IosDialog</item>
</style>
<style name="IosDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
<item name="colorAccent">@color/brand</item><item name="android:windowBackground">@drawable/bg_dialog</item>
<item name="buttonBarPositiveButtonStyle">@style/IosDialogButton</item><item name="buttonBarNegativeButtonStyle">@style/IosDialogButton</item><item name="buttonBarNeutralButtonStyle">@style/IosDialogButton</item>
</style>
<style name="IosDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
<item name="android:textAllCaps">false</item><item name="android:textColor">@color/brand</item><item name="android:textSize">16sp</item>
</style>
<style name="IosSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
<item name="android:thumb">@drawable/switch_thumb</item><item name="track">@drawable/switch_track</item>
<item name="thumbTint">@null</item><item name="trackTint">@null</item><item name="switchMinWidth">51dp</item><item name="android:background">@null</item>
</style>

<style name="FlowButton" parent="Widget.AppCompat.Button">
<item name="android:textAllCaps">false</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">15sp</item>
<item name="android:minHeight">44dp</item><item name="android:minWidth">0dp</item><item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item><item name="android:stateListAnimator">@null</item><item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item>
<item name="android:letterSpacing">0</item>
</style>
<style name="FlowPrimary" parent="FlowButton"><item name="android:background">@drawable/bg_primary</item><item name="android:textColor">#FFFFFF</item><item name="android:textSize">17sp</item></style>
<style name="FlowSecondary" parent="FlowButton"><item name="android:background">@drawable/bg_secondary</item><item name="android:textColor">@color/brand</item></style>
<!-- Full-width list row inside a grouped card: tappable, left-aligned, no chrome. -->
<style name="RowButton" parent="FlowButton">
<item name="android:background">@drawable/bg_row</item><item name="android:textColor">@color/row_text</item><item name="android:fontFamily">sans-serif</item><item name="android:textSize">16sp</item>
<item name="android:gravity">start|center_vertical</item><item name="android:layout_width">match_parent</item><item name="android:layout_height">48dp</item>
<item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item>
</style>
<style name="RowNav" parent="RowButton"><item name="android:textColor">@color/row_nav_text</item><item name="android:drawableEnd">@drawable/ic_chevron</item></style>
<style name="RowDanger" parent="RowButton"><item name="android:textColor">@color/row_danger_text</item></style>
<style name="Pill" parent="FlowButton">
<item name="android:background">@drawable/bg_pill</item><item name="android:textColor">@color/brand</item><item name="android:textSize">13sp</item>
<item name="android:minHeight">30dp</item><item name="android:paddingLeft">14dp</item><item name="android:paddingRight">14dp</item>
</style>
<style name="FlowInput" parent="Widget.AppCompat.EditText"><item name="android:textSize">16sp</item><item name="android:textColor">@color/text</item><item name="android:textColorHint">@color/muted</item><item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item><item name="android:background">@null</item><item name="backgroundTint">@null</item><item name="android:singleLine">true</item></style>

<style name="Card"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">vertical</item><item name="android:background">@drawable/bg_card</item></style>
<style name="PageTitle"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">32sp</item><item name="android:textColor">@color/text</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">-0.01</item><item name="android:paddingLeft">4dp</item></style>
<style name="PageSubtitle"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">13sp</item><item name="android:textColor">@color/muted</item><item name="android:paddingLeft">4dp</item><item name="android:layout_marginTop">2dp</item></style>
<style name="SectionHeader"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">13sp</item><item name="android:textColor">@color/muted</item><item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item><item name="android:layout_marginTop">24dp</item><item name="android:layout_marginBottom">7dp</item></style>
<style name="SectionFooter"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">12sp</item><item name="android:textColor">@color/muted</item><item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item><item name="android:layout_marginTop">7dp</item><item name="android:lineSpacingExtra">2dp</item></style>
<style name="RowTitle"><item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">16sp</item><item name="android:textColor">@color/text</item></style>
<style name="RowValue"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">14sp</item><item name="android:textColor">@color/muted</item></style>
<style name="Row"><item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item><item name="android:orientation">horizontal</item><item name="android:gravity">center_vertical</item><item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item></style>
<style name="Divider"><item name="android:layout_width">match_parent</item><item name="android:layout_height">@dimen/hairline</item><item name="android:background">@color/line</item><item name="android:layout_marginLeft">16dp</item></style>
<style name="CardBody"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">14sp</item><item name="android:textColor">@color/text</item><item name="android:lineSpacingExtra">4dp</item><item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item><item name="android:paddingTop">14dp</item><item name="android:paddingBottom">14dp</item></style>
</resources>
