</FrameLayout>

<LinearLayout android:id="@+id/homeNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="14dp" android:layout_marginTop="12dp" android:background="@drawable/bg_notice" android:visibility="gone">
<ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_alert" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
<TextView android:id="@+id/tvHomeResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text"/>
