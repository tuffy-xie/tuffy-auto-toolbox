<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginBottom="8dp" android:paddingLeft="4dp" android:text="每日" android:textColor="@color/text" android:textSize="21sp" android:textStyle="bold"/>
