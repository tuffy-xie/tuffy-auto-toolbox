<ImageView android:layout_width="8dp" android:layout_height="14dp" android:layout_marginStart="10dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no"/>
</LinearLayout>
</LinearLayout>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginBottom="8dp" android:paddingLeft="4dp" android:text="其他 App" android:textColor="@color/text" android:textSize="21sp" android:textStyle="bold"/>
